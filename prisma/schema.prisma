generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("staff") // admin | staff
  createdAt DateTime @default(now())
}

model Customer {
  id                   String    @id @default(cuid())
  name                 String
  phone                String    @unique
  address              String?
  notes                String?
  // Gas tracking
  gasAvgDays           Float?    // average days between gas purchases
  gasLastBuyDate       DateTime?
  gasLastQty           Float?    // kg
  gasCylinderQty       Int       @default(0) // số bình đang mượn (nếu có)
  // Rice tracking
  riceAvgDays          Float?
  riceLastBuyDate      DateTime?
  riceLastQty          Float?    // kg
  // Prediction
  gasPredictedDate     DateTime?
  ricePredictedDate    DateTime?
  urgencyScore         Float     @default(0)
  // Debt
  debtBalance          Float     @default(0) // positive = customer owes us
  // Cylinder deposit
  cylinderDeposit      Float     @default(0) // tiền cọc vỏ đang giữ
  cylinderDebt         Float     @default(0) // nợ vỏ
  // Metadata
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders               Order[]
}

// Bình rỗng: chỉ tổng số (không phân loại — vỏ thu về từ khách không biết loại)
// Bình đầy theo loại: dùng Product(type=gas).stock — không cần bảng riêng
model CylinderEmpty {
  id  String @id @default(cuid())
  qty Int    @default(0)   // tổng bình rỗng tại kho
}

model Product {
  id          String   @id @default(cuid())
  name        String
  type        String   // gas | rice | other
  unit        String   // kg | bottle | bag
  priceRetail Float
  priceWhole  Float?
  costPrice   Float?   // giá vốn / đơn vị (nhập tay, dùng cho báo cáo lợi nhuận)
  stock       Float    @default(0)
  minStock    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  priceHistory  PriceHistory[]
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        String      @default("pending") // pending(Chờ xử lý) | completed(Hoàn tất)
  paymentMethod String      @default("cash")    // cash | transfer | debt
  paidAmount    Float       @default(0)
  totalAmount   Float       @default(0)
  debtAmount    Float       @default(0)
  // Cylinder transaction
  cylinderTxType  String?                      // exchange | borrow | return
  cylinderDeposit Float     @default(0)        // tiền cọc thu/hoàn trong đơn này
  note          String?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Float
  unitPrice Float
  subtotal  Float
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  address   String?
  type      String     @default("gas") // gas | rice | other
  notes     String?
  createdAt DateTime   @default(now())

  purchases     Purchase[]
  ricePurchases RicePurchase[]
  priceHistory  PriceHistory[]
}

model Purchase {
  id           String         @id @default(cuid())
  purchaseNo   String         @unique
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  status       String         @default("draft")  // draft | received
  paymentStatus String        @default("paid")   // paid | owe
  totalAmount  Float          @default(0)
  paidAmount   Float          @default(0)
  cylinderTxType String?                        // exchange | buy
  cylinderQty    Int          @default(0)       // số vỏ giao dịch
  note         String?
  purchaseDate DateTime       @default(now())
  receivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items        PurchaseItem[]
  priceHistory PriceHistory[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Float
  unitCost   Float
  subtotal   Float
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  unitCost   Float
  date       DateTime @default(now())
}

model StockAudit {
  id          String   @id @default(cuid())
  productId   String
  type        String   // in | out | adjust
  qty         Float
  beforeQty   Float
  afterQty    Float
  reason      String?
  refId       String?  // orderId or purchaseId
  createdAt   DateTime @default(now())
}

// ── Quản lý gạo (nhập riêng, bán riêng) ────────────────────────────────────
// Lý do tách: nhập theo kg bulk, bán theo bao nhỏ → đơn vị không khớp
// RiceProduct  = danh mục loại gạo nhập (ST25, Jasmine...)
// RicePurchase = phiếu nhập gạo (1 phiếu nhiều loại)
// Product(rice)= sản phẩm bán ra (bao 5kg, 10kg...) trong Orders

model RiceProduct {
  id             String             @id @default(cuid())
  name           String             // "Gạo ST25", "Gạo Jasmine"...
  description    String?            // mô tả / nguồn gốc
  lastPricePerKg Float?             // giá nhập gần nhất (tự cập nhật khi có phiếu mới)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  purchaseItems  RicePurchaseItem[]
}

model RicePurchase {
  id            String             @id @default(cuid())
  purchaseNo    String             @unique       // RG00001, RG00002...
  purchaseDate  DateTime           @default(now())
  supplierId    String?
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  paymentStatus String             @default("paid") // paid | owe
  totalCost     Float              @default(0)       // Σ subtotal của items
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items         RicePurchaseItem[]
}

model RicePurchaseItem {
  id             String       @id @default(cuid())
  ricePurchaseId String
  ricePurchase   RicePurchase @relation(fields: [ricePurchaseId], references: [id], onDelete: Cascade)
  riceProductId  String
  riceProduct    RiceProduct  @relation(fields: [riceProductId], references: [id])
  totalKg        Float        // số kg nhập loại gạo này
  pricePerKg     Float        // giá nhập/kg
  subtotal       Float        // = totalKg × pricePerKg
}
